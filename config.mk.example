# =============================================================================
# 複製成 config.mk 後填入你的專案路徑：
#
#     cp config.mk.example config.mk
#
# 路徑可以是相對於你執行 make 的目錄，也可以是絕對路徑。
# config.mk 屬於個別專案的設定，不需要 commit 進這個工具的 repo。
# =============================================================================

# --- 必填 --------------------------------------------------------------------

# Vivado 專案檔
PROJECT   = build/top.xpr

# 要稽核的 RTL 目錄（可多個，用空白分隔）
RTL_DIRS  = rtl

# 要稽核的 XDC 目錄（可多個）
XDC_DIRS  = constrs

# --- 選填 --------------------------------------------------------------------

# 外部 file list（.f / .tcl / .txt，可多個）。
# 設了才會執行 `make check-files`，並與 .xpr 對帳。
FILELIST  = filelist.f

# 分析輸出目錄
OUTDIR    = timing_analysis

# RTL 的 git working tree，用來記錄 commit
REPO_ROOT = .

# 要建置的 implementation run 名稱
RUN       = impl_1

# launch_runs 的平行數
JOBS      = 4

# 已核准豁免項目的檔案；不存在就直接忽略
WAIVERS   = waivers.json

# 稽核時要略過的檔案（glob，可多個），例如 testbench
# EXCLUDE = */tb/* */sim/*

# 模組掃描要忽略的名稱（可多個）。
# `make check-files` 會比對「被實例化的模組」與「有定義的模組」，
# 在 elaboration 之前就抓出找不到的模組。
# Xilinx primitive（BUFG、FDRE…）與 .xci 的 IP 已自動排除；
# 若還有由外部函式庫提供、掃不到定義的模組，列在這裡。
# IGNORE_MODULES = my_encrypted_ip vendor_macro

# --- 補產缺少的 IP -----------------------------------------------------------

# 你自己的 IP 產生腳本。`make check-files` 掃到被實例化卻不存在、且名稱長得像
# blk_mem_gen_<深度>x<寬度> 的模組時，會把尺寸寫進
# timing_analysis/manifests/missing_ip_specs.txt，`make gen-ip` 再把那份清單
# 餵給這支腳本。本工具不自己產生 IP —— 你的腳本才知道正確的 core 版本與組態。
#
# 腳本開頭的 spec 清單請包成守衛，單獨執行時行為完全不變：
#     if {![info exists sram_specs]} {
#         set sram_specs { 2048x8 }
#     }
# SRAM_GEN_TCL = tcl/gen_sram_checkdouble2.tcl

# 設成 1 時，`make check` 在階段 1 發現缺 IP 會自動先跑 gen-ip 再重檢一次。
# 預設 0：只憑模組名稱產生的 IP 組態是寫死的（單埠、無 byte write enable），
# 有機會生出「名稱對、組態錯」的 core —— elaboration 會過，上板卻是錯的。
# GEN_IP_AUTO = 1

# 若 vivado 或 python3 不在 PATH 上，在這裡指定完整路徑
# VIVADO = /tools/Xilinx/Vivado/2024.2/bin/vivado
# PYTHON = /tools/Xilinx/Vivado/2024.2/tps/lnx64/python-3.10.6/bin/python3
